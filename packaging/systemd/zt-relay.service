# TCN relay. Installation: see docs/OPERATIONS.md §9.
# Expected files (checked by zt-relay like OpenSSH's StrictModes):
#   /etc/tcn            root:root 0755
#   /etc/tcn/relay.key  tcn:tcn   0600
#   /etc/tcn/policy.toml root:root 0644   (systemctl reload zt-relay after a change)
[Unit]
Description=TCN relay (zt-relay)
Documentation=https://github.com/pietrangelo/TransportCryptoNetwork/blob/main/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
# notify: READY=1 arrives only once SIGHUP is handled (systemctl reload is safe right away).
Type=notify
NotifyAccess=main
User=tcn
Group=tcn
# For IPv6 dual-stack: --listen [::]:7443
# Key rotation: in a drop-in --key /etc/tcn/relay.next.key
# --previous-key /etc/tcn/relay.key and a restart (OPERATIONS §8). Every systemctl reload,
# even one just for the policy, also rereads the keys.
ExecStart=/usr/local/bin/zt-relay --log-format json run --listen 0.0.0.0:7443 --key /etc/tcn/relay.key --policy /etc/tcn/policy.toml
# Reloads the policy and live-revokes connections that are no longer allowed.
ExecReload=/bin/kill -HUP $MAINPID
# always: even a signal (e.g. a mistimed SIGHUP) counts as a clean exit.
Restart=always
RestartSec=2s
LimitNOFILE=16384
Environment=RUST_LOG=info

# --- sandbox ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
ReadOnlyPaths=/etc/tcn

[Install]
WantedBy=multi-user.target
