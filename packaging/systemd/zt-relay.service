# Relay TCN. Installazione: vedi docs/OPERATIONS.md §9.
# File attesi (controllati da zt-relay come StrictModes di OpenSSH):
#   /etc/tcn            root:root 0755
#   /etc/tcn/relay.key  tcn:tcn   0600
#   /etc/tcn/policy.toml root:root 0644   (systemctl reload zt-relay dopo una modifica)
[Unit]
Description=TCN relay (zt-relay)
Documentation=https://github.com/pietrangelo/TransportCryptoNetwork/blob/main/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
# notify: READY=1 arriva solo quando SIGHUP è gestito (systemctl reload sicuro da subito).
Type=notify
NotifyAccess=main
User=tcn
Group=tcn
# Per IPv6 dual-stack: --listen [::]:7443
# Durante una rotazione della chiave aggiungi --previous-key /etc/tcn/relay.prev.key
# (OPERATIONS §8); systemctl reload ricarica poi entrambe le chiavi.
ExecStart=/usr/local/bin/zt-relay --log-format json run --listen 0.0.0.0:7443 --key /etc/tcn/relay.key --policy /etc/tcn/policy.toml
# Ricarica la policy e revoca a caldo le connessioni non più ammesse.
ExecReload=/bin/kill -HUP $MAINPID
# always: anche un segnale (es. SIGHUP fuori tempo) conta come uscita pulita.
Restart=always
RestartSec=2s
LimitNOFILE=16384
Environment=RUST_LOG=info

# --- sandbox ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
ReadOnlyPaths=/etc/tcn

[Install]
WantedBy=multi-user.target
