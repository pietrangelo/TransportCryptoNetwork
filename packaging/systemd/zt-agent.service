# TCN agent on the target servers: no listening ports, only outbound connections to the
# relay and to sshd on 127.0.0.1:22. Installation: see docs/OPERATIONS.md §9.
# Expected files:
#   /etc/tcn               root:root 0755
#   /etc/tcn/agent.key     tcn:tcn   0600
#   /etc/tcn/clients.toml  root:root 0644   (systemctl reload zt-agent after a change)
#   /etc/tcn/agent.env     root:root 0644   with TCN_RELAY, TCN_RELAY_KEY, TCN_NODE
#                          (multiple relays: TCN_RELAY=r1:7443,r2:7443 and TCN_RELAY_KEY=k1,k2)
#                          and, for new installations, the end-to-end suites (OPERATIONS §9, §12):
#                          TCN_ACCEPT_CLIENT_SUITES=Noise_IK_25519_ChaChaPoly_BLAKE2s,Noise_IKhfs_25519+MLKEM768_ChaChaPoly_BLAKE2s
#                          (read by zt-agent itself; without it, the classical suite alone)
[Unit]
Description=TCN agent (zt-agent)
Documentation=https://github.com/pietrangelo/TransportCryptoNetwork/blob/main/docs/OPERATIONS.md
After=network-online.target time-sync.target sshd.service
Wants=network-online.target
# Restarts are never given up on (the backoff below spaces them out).
StartLimitIntervalSec=0

[Service]
# notify: READY=1 arrives only once SIGHUP is handled (systemctl reload is safe right away);
# every SIGHUP is announced with RELOADING=1 and closed with READY=1.
Type=notify
NotifyAccess=main
User=tcn
Group=tcn
# /run/zt-agent: where the running process publishes the outcome of each reload for
# `zt-agent reload` ($RUNTIME_DIRECTORY).
RuntimeDirectory=zt-agent
RuntimeDirectoryMode=0700
EnvironmentFile=/etc/tcn/agent.env
ExecStart=/usr/local/bin/zt-agent --log-format json run --relay ${TCN_RELAY} --relay-key ${TCN_RELAY_KEY} --node ${TCN_NODE} --key /etc/tcn/agent.key --authorized-clients /etc/tcn/clients.toml --ssh-target 127.0.0.1:22
# Reloads the authorized clients and immediately closes the sessions of those removed.
# `reload` sends SIGHUP to the running agent and waits for its own verdict: the agent
# validates its files with its own ExecStart= arguments (drop-ins included), so
# `systemctl reload` fails exactly when the agent rejected them (OPERATIONS §4). It
# takes no file arguments on purpose (review 0010, A10-1).
ExecReload=/usr/local/bin/zt-agent --log-format json reload --pid $MAINPID
# SIGTERM drains (OPERATIONS §14): new sessions get NodeOffline, open ones get up to
# --drain-timeout (60 s by default). TimeoutStopSec leaves room for it.
TimeoutStopSec=90s
WatchdogSec=60s
# A configuration error (exit 78: a file that was read and is invalid) is not restarted: it
# needs an operator, not a loop. A missing or unreadable file (provisioning not finished, a
# late mount) exits 1 and is retried with the backoff below.
Restart=always
RestartPreventExitStatus=78
RestartSec=2s
# Exponential restart backoff up to 60 s (systemd 254 and later; older versions ignore it).
RestartSteps=5
RestartMaxDelaySec=60s
# No core dumps: the process holds secret keys (zt-agent also sets PR_SET_DUMPABLE 0).
LimitCORE=0
Environment=RUST_LOG=info

# --- sandbox ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
ReadOnlyPaths=/etc/tcn
# Optional, if the relay's IP is fixed: the agent can talk only to the relay and to sshd.
#IPAddressDeny=any
#IPAddressAllow=localhost <relay IP>

[Install]
WantedBy=multi-user.target
